#!/bin/sh

SERVER_URL=""
if [ -f "/etc/OneCore/SrvURL" ]; then
	SERVER_URL="$(cat /etc/OneCore/SrvURL)"
elif [ -f "/etc/OneCore/OneCoreNET%DOMAIN" ]; then
	SERVER_URL="$(cat /etc/OneCore/OneCoreNET%DOMAIN)"
else
	SERVER_URL="http://onecore.compy.ca"
fi

printf " :: Do you have a registration key? (Y/N) "
read HAS_KEY

PRODUCTS=""
TCZ_TOINSTALL=""

case "$HAS_KEY" in
	Y|y)
		while true; do
			printf " :: Enter your registration key (format: XXXXX-XXXXX-XXXXX): "
			read REG_KEY

			# Check if format is correct #
			case "$REG_KEY" in
				?????-?????-?????)
					;;
				*)
					echo " !! Error: Invalid key format. Use XXXXX-XXXXX-XXXXX."
					continue
					;;
			esac

			FILE_URL="$SERVER_URL/NET/Registrations/OCL/${REG_KEY}.rp"

			echo " :: Verifying registration key..."

			# Try to download content directly into a variable #
			REG_RESPONSE="$(wget -UOneCoreNET/OneCoreLinuxV3 -qO - "$FILE_URL")"
			if [ $? -eq 0 ] && [ -n "$REG_RESPONSE" ]; then
				echo " :: Registration successful."

				echo " :: You have the following registered products available:"
				echo

				for PRODUCT in $REG_RESPONSE; do
					echo "        $PRODUCT"
				done
				echo

				printf " ?? Is this correct? (Y/N) "
				read IS_CORRECT
				case "$IS_CORRECT" in
					Y|y)
						PRODUCTS="$REG_RESPONSE"
						echo " :: Registration confirmed."
						break
						;;
					*)
						echo " !! Error: Registration rejected by user. Restarting..."
						continue
						;;
				esac
			else
				echo " !! Error: Invalid registration key or network issue."
				printf " ?? Would you like to try again? (Y/N) "
				read TRY_AGAIN
				case "$TRY_AGAIN" in
					Y|y)
						continue
						;;
					*)
						echo " :: Skipping product registration."
						break
						;;
				esac
			fi
		done
		;;
	*)
		echo " :: Skipping product registration."
		;;
esac

EnumDisks(){
	for DEV in /sys/block/*; do
		NAME="$(basename "$DEV")"
		case "$NAME" in
			loop*|ram*) continue ;;
		esac
		if [ -b "/dev/$NAME" ]; then
			echo "        /dev/$NAME"
		fi
	done
}

echo
echo " :: The following drives have been found on your device:"
EnumDisks
echo

while true; do
	printf " :: Select the drive on which you want to install OCL: "
	read INSTALL_DRIVE

	if [ -b "$INSTALL_DRIVE" ]; then
		printf " ?? You selected $INSTALL_DRIVE. Confirm? (Y/N) "
		read CONFIRM
		case "$CONFIRM" in
			Y|y)
				echo " :: Drive selected: $INSTALL_DRIVE"
				break
				;;
			*)
				echo
				echo " :: The following drives have been found on your device:"
				EnumDisks
				continue
				;;
		esac
	else
		echo " !! Error: Invalid drive. Choose again."
	fi
done

printf " :: Do you want to install a desktop environment? (Y/N) "
read INSTALL_DE

if [ "$INSTALL_DE" = "Y" ] || [ "$INSTALL_DE" = "y" ]; then
	echo
	OPTIONS=""
	COUNT=1

	if echo "$PRODUCTS" | grep -qw "OneCore-RDE"; then
		echo "        $COUNT. Reference Desktop Environment"
		OPTIONS="$OPTIONS RDE"
		COUNT=$((COUNT+1))
	fi

	if echo "$PRODUCTS" | grep -qw "OCL-X11TWM"; then
		echo "        $COUNT. twm"
		OPTIONS="$OPTIONS twm"
		COUNT=$((COUNT+1))
	fi

	echo "        $COUNT. jwm"
	OPTIONS="$OPTIONS jwm"
	COUNT=$((COUNT+1))

	echo "        $COUNT. icewm"
	OPTIONS="$OPTIONS icewm"
	COUNT=$((COUNT+1))

	echo "        $COUNT. fluxbox"
	OPTIONS="$OPTIONS fluxbox"

	echo
	while true; do
		printf " :: Select desktop environment by number: "
		read DE_CHOICE

		SELECTED="$(echo $OPTIONS | cut -d' ' -f$DE_CHOICE)"

		case "$SELECTED" in
			RDE)
				TCZ_TOINSTALL="$TCZ_TOINSTALL Xfbdev Xorg-7.7-3d rpcbind motif lmdb libXpm libXss"
				break
				;;
			twm)
				TCZ_TOINSTALL="$TCZ_TOINSTALL Xfbdev Xorg-7.7-3d"
				break
				;;
			jwm)
				TCZ_TOINSTALL="$TCZ_TOINSTALL Xfbdev Xorg-7.7-3d jwm"
				break
				;;
			icewm)
				TCZ_TOINSTALL="$TCZ_TOINSTALL Xfbdev Xorg-7.7-3d icewm"
				break
				;;
			fluxbox)
				TCZ_TOINSTALL="$TCZ_TOINSTALL Xfbdev Xorg-7.7-3d fluxbox"
				break
				;;
			*)
				echo " !! Error: Invalid selection."
				;;
		esac
	done
fi

BASE_SOURCE=""

while true; do
	echo " :: From where should the Base OS be installed?"
	echo
	echo "        1. From the Cloud"
	echo "        2. From the Install Media"
	echo
	printf " :: Select an option (1/2): "
	read BASE_CHOICE

	case "$BASE_CHOICE" in
		1)
			BASE_SOURCE="Cloud"
			break
			;;
		2)
			BASE_SOURCE="InstallMedia"
			break
			;;
		*)
			echo " !! Error: Invalid selection."
			;;
	esac
done


echo " ************************************************ "
echo " **       OneCore Linux V3 Installation           "
echo " **                                               "
echo " **  Install on: $INSTALL_DRIVE                   "
echo " **  Products:                                    "
for PRODUCT in $PRODUCTS; do
	echo " **    - $PRODUCT"
done
echo " **  Install Source: $BASE_SOURCE                 "
echo " **                                               "
echo " ************************************************ "

while true; do
	printf " ?? Is the information above correct? (Y/N) "
	read CONFIRM_INFO

	case "$CONFIRM_INFO" in
		Y|y)
			INFO_CONFIRMED=1
			break
			;;
		N|n)
			INFO_CONFIRMED=0
			break
			;;
		*)
			echo " !! Error: Invalid input."
			;;
	esac
done

#sudo -u oc tce-load -wi parted dosfstools
tceflight parted dosfstools
if [ -d /sys/firmware/efi ]; then
	echo " :: Detected EFI system"
	parted -s "$INSTALL_DRIVE" mklabel gpt

	echo " :: Creating EFI System Partition (OCLBOOT)"
	parted -s "$INSTALL_DRIVE" mkpart OCLBOOT fat32 1MiB 301MiB
	parted -s "$INSTALL_DRIVE" set 1 esp on

	echo " :: Creating Linux Partition (OCLMAIN)"
	parted -s "$INSTALL_DRIVE" mkpart OCLMAIN ext4 301MiB 100%
else
	echo " :: Detected BIOS system"
	parted -s "$INSTALL_DRIVE" mklabel msdos

	echo " :: Creating Bootable Linux Partition (OCLBOOT)"
	parted -s "$INSTALL_DRIVE" mkpart primary ext4 1MiB 301MiB
	parted -s "$INSTALL_DRIVE" set 1 boot on

	echo " :: Creating Linux Partition (OCLMAIN)"
	parted -s "$INSTALL_DRIVE" mkpart primary ext4 301MiB 100%
fi

echo " :: Formatting partitions"
mkfs.vfat -F32 "${INSTALL_DRIVE}1"
mkfs.ext4 -F "${INSTALL_DRIVE}2"

echo " :: Installing bootloader"
limine bios-install "$INSTALL_DRIVE"

echo " :: Mounting OCLBOOT for configuration"
mkdir -p "/tmp/audit/OCLBOOT"
mkdir -p "/tmp/audit/OCLMAIN"
mkdir -p "/tmp/audit/OCLMEDIA"

mount "${INSTALL_DRIVE}1" "/tmp/audit/OCLBOOT"
mkdir -p "/tmp/audit/OCLBOOT/boot/limine"
if [ -d /sys/firmware/efi ]; then
	echo " :: Copying EFI files"
	mkdir -p "/tmp/audit/OCLBOOT/EFI/BOOT/"
	cp "/usr/local/share/limine/BOOTX64.EFI" "/tmp/audit/OCLBOOT/EFI/BOOT/"
else
	echo " :: Copying BIOS files"
	cp "/usr/local/share/limine/limine-bios.sys" "/tmp/audit/OCLBOOT/boot/limine/"
fi

echo " :: Creating bootloader config"
SOLO_PART="$(echo "${INSTALL_DRIVE}2" | sed 's|/dev/||')"

echo "timeout: 5" > "/tmp/audit/OCLBOOT/boot/limine/limine.conf"
echo "/OneCore Linux V$(cat /etc/OneCore/OSVer)" >> "/tmp/audit/OCLBOOT/boot/limine/limine.conf"
echo "    protocol: linux" >> "/tmp/audit/OCLBOOT/boot/limine/limine.conf"
echo "    kernel_path: boot():/boot/vmlinuz" >> "/tmp/audit/OCLBOOT/boot/limine/limine.conf"
echo "    module_path: boot():/boot/onecore64.gz" >> "/tmp/audit/OCLBOOT/boot/limine/limine.conf"
echo "    cmdline: quiet rw loglevel=3< vga=792 xvesa=1024x768x32 tce=${SOLO_PART} opt=${SOLO_PART} home=${SOLO_PART} oclpart=${SOLO_PART} syspart=${INSTALL_DRIVE}1 root=${INSTALL_DRIVE}2" >> "/tmp/audit/OCLBOOT/boot/limine/limine.conf"

if [ "$BASE_SOURCE" = "InstallMedia" ]; then
	echo " :: Copying Base OS "
	mount "/dev/sr0" "/tmp/audit/OCLMEDIA"
	cp "/tmp/audit/OCLMEDIA/boot/vmlinuz" "/tmp/audit/OCLBOOT/boot/vmlinuz"
	cp "/tmp/audit/OCLMEDIA/boot/onecore64.gz" "/tmp/audit/OCLBOOT/boot/onecore64.gz"
	umount "/tmp/audit/OCLMEDIA"
else
	echo " :: Downloading Base OS"
	wget -q -U"OneCoreNET/OneCoreLinuxV3" "$SERVER_URL/ipxe/OCL/V3/vmlinuz" -O "/tmp/audit/OCLBOOT/boot/vmlinuz"
	wget -q -U"OneCoreNET/OneCoreLinuxV3" "$SERVER_URL/ipxe/OCL/V3/onecore64.gz" -O "/tmp/audit/OCLBOOT/boot/onecore64.gz"
fi

echo " :: Unmounting OCLBOOT"
umount "/tmp/audit/OCLBOOT"

echo " :: Mounting OCLMAIN"
mount "${INSTALL_DRIVE}2" "/tmp/audit/OCLMAIN"

mkdir -p "/tmp/audit/OCLMAIN/PostSetup"
mkdir -p "/tmp/audit/OCLMAIN/tce/optional"
echo 'SCRIPT_DIR="$1"' > "/tmp/audit/OCLMAIN/PostSetup/.BootSetup"
echo 'cd "$SCRIPT_DIR"' >> "/tmp/audit/OCLMAIN/PostSetup/.BootSetup"
echo "tce-load -wi $TCZ_TOINSTALL" >> "/tmp/audit/OCLMAIN/PostSetup/.BootSetup"
echo "echo tce-load oc tce-load -wi $TCZ_TOINSTALL" >> "/tmp/audit/OCLMAIN/PostSetup/.BootSetup"
echo
for PRODUCT in $REG_RESPONSE; do
	printf " ?? Do you want to install your product '$PRODUCT' (Y/N) "
	read INSTALL_PRODUCT
	case "$INSTALL_PRODUCT" in
		Y|y)
			mkdir -p "/tmp/audit/OCLMAIN/.products/$PRODUCT"
			cd "/tmp/audit/OCLMAIN/.products/$PRODUCT"
			echo " :: Downloading product..."
			wget -q -U"OneCoreNET/OneCoreLinuxV3" "$SERVER_URL/Distrib/Software/OS/OCL-V3-amd64/$PRODUCT.rpk" -O "Product.rpk"
			wget -q -U"OneCoreNET/OneCoreLinuxV3" "$SERVER_URL/Distrib/Software/OS/OCL-V3-amd64/$PRODUCT.pkv" -O "Product.pkv"
			V_HASH="$(cat Product.pkv)"
			R_HASH="$(sha1sum Product.rpk | awk '{print $1}')"

			if [ "$V_HASH" = "$R_HASH" ]; then
				echo " :: Extracting product... (this may take a while)"
				unzip -q "Product.rpk" 2>/dev/ttyS0
				if [ -f "./pactinst.sh" ]; then
					echo " :: Installing product..."
					sh "./pactinst.sh" "/tmp/audit/OCLMAIN"
					echo " :: Cleaning product..."
					cd "/"
					rm -rf "/tmp/audit/OCLMAIN/.products/$PRODUCT"
				else
					echo " !! Product does not support PACT Installation"
				fi
			else
				echo " !! Product has failed to verify. Contact vendor for newer version."
			fi
			continue
			;;
		*)
			continue
			;;
	esac
done

echo " :: Unmounting OCLMAIN"
umount "/tmp/audit/OCLMAIN"

echo " :: Done"
